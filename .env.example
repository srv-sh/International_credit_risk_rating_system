# Copy to .env and fill in. .env is not tracked.

# Use the canned OCR output in saved_responses/ instead of calling the OCR+LLM
# backend. Leave this at 1 unless you have the OCR service running and a key.
USE_SAVED_RESPONSE=1

# OCR backend. Only used when USE_SAVED_RESPONSE=0. This is a separate service
# that is not part of this repo; it serves POST /extract.
BACKEND_URL=http://localhost:8000
BACKEND_TIMEOUT=900

# LLM used to match statement lines to items. Only used when USE_SAVED_RESPONSE=0.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Postgres credentials used by docker compose.
STORE_DB_USER=postgres
STORE_DB_PASSWORD=postgres
STORE_DB_NAME=credit_risk
